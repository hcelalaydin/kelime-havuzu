[Unit]
Description=Kelime Havuzu multiplayer game
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kelime-havuzu
Group=kelime-havuzu
WorkingDirectory=/opt/kelime-havuzu/current
EnvironmentFile=/etc/kelime-havuzu/environment
ExecStart=/opt/kelime-havuzu/node/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kelime-havuzu
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
