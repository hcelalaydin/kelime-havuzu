{
  "name": "kelime-havuzu",
  "version": "2.0.0",
  "private": true,
  "description": "Arkadaşlarınla dört aşamalı kelime oyunu",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:docker": "node test/docker-smoke.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "proxy-addr": "2.0.8",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4"
  }
}
